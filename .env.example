# ==============================================================================
# Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# 1. GitHub Configuration
# Personal Access Token (PAT) with 'repo' scope to post review comments.
GITHUB_TOKEN=your_github_pat_here

# 2. Database Configuration (Local PostgreSQL or Hosted Neon / Supabase)
# - Local fallback: postgresql://postgres:postgres@localhost:5432/pr_review_db
# - Neon / Supabase: postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pr_review_db

# 3. LLM Configuration (Ollama vs Hosted Groq)
# LLM_PROVIDER=groq or LLM_PROVIDER=ollama
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Local Ollama fallback settings
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b

# 4. Vector Embedding Configuration (Ollama nomic-embed-text vs Hosted Jina AI)
# EMBEDDING_PROVIDER=jina or EMBEDDING_PROVIDER=ollama
EMBEDDING_PROVIDER=jina
JINA_API_KEY=jina_your_jina_api_key_here
JINA_EMBED_MODEL=jina-embeddings-v2-base-en
EMBED_MODEL=nomic-embed-text

# 5. Vector Database (Qdrant Local or Qdrant Cloud)
# - Local host: http://localhost:6333
# - Qdrant Cloud: https://xxxxxx.us-east-4-0.aws.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_optional

# 6. Demo Mode & Safety Configurations
# Set DEMO_MODE=true or omit GITHUB_TOKEN to load pre-recorded sample review traces for recruiters
DEMO_MODE=false
DRY_RUN=false

# 7. Analytics Dashboard Configuration
API_URL=http://localhost:8000
